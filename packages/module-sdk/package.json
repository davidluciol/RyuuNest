{
  "name": "@ryuunest/module-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SDK público de RyuuNest: tipos, validador de manifest, CLI y plantilla de módulos.",
  "license": "GPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ryuunest-module": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@ryuunest/core": "workspace:*",
    "@ryuunest/test-site": "workspace:*",
    "fflate": "^0.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  }
}
