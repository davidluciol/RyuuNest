{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@ryuunest/mobile-src/*": ["../mobile/src/*"],
      "@ryuunest/core": ["../../packages/core/src/index.ts"],
      "@ryuunest/i18n": ["../../packages/i18n/src/index.ts"],
      "@ryuunest/module-sdk": ["../../packages/module-sdk/src/index.ts"],
      "@ryuunest/test-site": ["../../packages/test-site/src/index.ts"],
      "@ryuunest/ui-tokens": ["../../packages/ui-tokens/src/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
