    "@ryuunest/ui-tokens": "workspace:*",
    "fflate": "^0.8.3",
    "lucide-react": "1.66.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.5",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.4"
